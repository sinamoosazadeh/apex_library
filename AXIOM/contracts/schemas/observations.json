{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/contracts/schemas/observations.json",
  "title": "AXIOM scalar venue observations (funding, OI, mark/index, ratio)",
  "oneOf": [
    { "type":"object","additionalProperties":false,
      "required":["kind","instrument_id","ts","rate","first_ingest_ts","source"],
      "properties":{"kind":{"const":"FUNDING_RATE"},"instrument_id":{"$ref":"common.json#/$defs/instrument_id"},
        "ts":{"$ref":"common.json#/$defs/ts_ms"},"rate":{"$ref":"common.json#/$defs/decimal"},
        "next_funding_time":{"$ref":"common.json#/$defs/ts_ms"},"period":{"type":"string"},
        "first_ingest_ts":{"$ref":"common.json#/$defs/ts_ms"},"source":{"$ref":"common.json#/$defs/source_tag"}} },
    { "type":"object","additionalProperties":false,
      "required":["kind","instrument_id","ts","oi","first_ingest_ts","source"],
      "properties":{"kind":{"const":"OPEN_INTEREST"},"instrument_id":{"$ref":"common.json#/$defs/instrument_id"},
        "ts":{"$ref":"common.json#/$defs/ts_ms"},"oi":{"$ref":"common.json#/$defs/decimal"},"oi_value":{"$ref":"common.json#/$defs/decimal"},
        "first_ingest_ts":{"$ref":"common.json#/$defs/ts_ms"},"source":{"$ref":"common.json#/$defs/source_tag"}} },
    { "type":"object","additionalProperties":false,
      "required":["kind","instrument_id","ts","mark","first_ingest_ts","source"],
      "properties":{"kind":{"const":"MARK_PRICE"},"instrument_id":{"$ref":"common.json#/$defs/instrument_id"},
        "ts":{"$ref":"common.json#/$defs/ts_ms"},"mark":{"$ref":"common.json#/$defs/decimal"},
        "index_price":{"$ref":"common.json#/$defs/decimal"},"est_settle":{"$ref":"common.json#/$defs/decimal"},
        "next_funding_time":{"$ref":"common.json#/$defs/ts_ms"},"funding_rate":{"$ref":"common.json#/$defs/decimal"},
        "first_ingest_ts":{"$ref":"common.json#/$defs/ts_ms"},"source":{"$ref":"common.json#/$defs/source_tag"}} },
    { "type":"object","additionalProperties":false,
      "required":["kind","instrument_id","ts","price","first_ingest_ts","source"],
      "properties":{"kind":{"const":"INDEX_PRICE"},"instrument_id":{"$ref":"common.json#/$defs/instrument_id"},
        "ts":{"$ref":"common.json#/$defs/ts_ms"},"price":{"$ref":"common.json#/$defs/decimal"},
        "components":{"type":"array","items":{"type":"string"}},
        "first_ingest_ts":{"$ref":"common.json#/$defs/ts_ms"},"source":{"$ref":"common.json#/$defs/source_tag"}} },
    { "type":"object","additionalProperties":false,
      "required":["kind","instrument_id","ts","period","first_ingest_ts","source"],
      "properties":{"kind":{"const":"LONG_SHORT_RATIO"},"instrument_id":{"$ref":"common.json#/$defs/instrument_id"},
        "ts":{"$ref":"common.json#/$defs/ts_ms"},"period":{"type":"string"},
        "long_account":{"type":"number"},"short_account":{"type":"number"},
        "long_position":{"type":"number"},"short_position":{"type":"number"},
        "first_ingest_ts":{"$ref":"common.json#/$defs/ts_ms"},"source":{"$ref":"common.json#/$defs/source_tag"}} }
  ]
}
