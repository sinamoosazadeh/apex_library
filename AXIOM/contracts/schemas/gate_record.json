{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/contracts/schemas/gate_record.json",
  "title": "AXIOM GateRecord",
  "description": "Evidence of passing a gate or a ladder rung (AX-10 §4.1, AX-14 §6). Promotions are never automatic: decided_by must be an operator id unless decision is a DEMOTION.",
  "type": "object", "additionalProperties": false,
  "required": ["gate_record_id","ts","gate","evidence_refs","metrics","decision","decided_by"],
  "properties": {
    "gate_record_id": { "$ref": "common.json#/$defs/ulid" },
    "ts": { "$ref": "common.json#/$defs/ts_ms" },
    "gate": { "enum": ["G0","G1","G2","G3","G4","G5","G6","L0","L1","L2","L3","L4","L5","L6"] },
    "rung_from": { "type": ["string","null"] },
    "rung_to": { "type": ["string","null"] },
    "artifact_set": {
      "type": "object", "additionalProperties": false,
      "required": ["code_commit","param_set_hash","profile_hash"],
      "properties": {
        "code_commit": { "type": "string" }, "param_set_hash": { "$ref": "common.json#/$defs/hash" },
        "profile_hash": { "$ref": "common.json#/$defs/hash" },
        "model_hashes": { "type": "array", "items": { "$ref": "common.json#/$defs/hash" } }
      }
    },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "common.json#/$defs/hash" } },
    "tests": { "type": "array", "items": { "type": "object", "additionalProperties": false,
        "required": ["test_id","result"],
        "properties": { "test_id": { "type": "string" }, "result": { "enum": ["PASS","FAIL","SKIPPED"] },
                        "evidence_ref": { "$ref": "common.json#/$defs/hash" } } } },
    "metrics": { "type": "object" },
    "decision": { "enum": ["PASS","FAIL","DEMOTION","WAIVED_BY_ADR"] },
    "adr_ref": { "type": "string" },
    "decided_by": { "type": "string", "minLength": 1 }
  }
}
