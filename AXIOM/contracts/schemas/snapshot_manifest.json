{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.local/contracts/schemas/snapshot_manifest.json",
  "title": "AXIOM Snapshot manifest",
  "description": "Point-in-time digest of everything a decision consumed (AX-04 §5). Two processes that disagree on the manifest digest must refuse to trade (T-SNAP-001).",
  "type": "object", "additionalProperties": false,
  "required": ["snapshot_id","as_of","partitions","param_set_hash","code_commit","profile_hash","manifest_digest"],
  "properties": {
    "snapshot_id": { "$ref": "common.json#/$defs/ulid" },
    "as_of": { "$ref": "common.json#/$defs/ts_ms" },
    "universe_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "partitions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["name","digest","rows"],
        "properties": { "name": { "type": "string" }, "digest": { "$ref": "common.json#/$defs/hash" },
                        "rows": { "type": "integer", "minimum": 0 },
                        "watermark_ts": { "$ref": "common.json#/$defs/ts_ms" } } }
    },
    "model_hashes": { "type": "array", "items": { "$ref": "common.json#/$defs/hash" } },
    "param_set_hash": { "$ref": "common.json#/$defs/hash" },
    "code_commit": { "type": "string" },
    "profile_hash": { "$ref": "common.json#/$defs/hash" },
    "manifest_digest": { "$ref": "common.json#/$defs/hash" }
  }
}
